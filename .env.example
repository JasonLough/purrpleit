# Any OpenAI-compatible chat completions endpoint works.
# OpenRouter (default):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Pick any model id from https://openrouter.ai/models
LLM_MODEL=

# Local Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1
