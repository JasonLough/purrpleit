# Copy this file to .env.local and fill it in, then restart `pnpm dev`.
# Any OpenAI-compatible /chat/completions endpoint works. See README.md for details.

# --- OpenRouter (default) ---
# 1. Create a key:  https://openrouter.ai/settings/keys
# 2. Add credits:   https://openrouter.ai/settings/credits  (not needed for :free models)
# 3. Pick a model:  https://openrouter.ai/models  (copy the "provider/model-name" ID)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini
# Free, but rate-limited:
# LLM_MODEL=google/gemma-4-31b-it:free

# --- Ollama (fully local) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1
